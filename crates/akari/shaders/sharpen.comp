#version 460
// Contrast Adaptive Sharpening (after AMD FidelityFX CAS), on the final display-referred image.
// Restores the fine leaf detail that TAA and the supersampling downscale soften, while limiting the
// sharpening where local contrast is already high (no halos around branches against the sky).
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform readonly image2D src;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform SharpenPC { float sharpness; } pc; // 0 = off .. 1 = max

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(src);
    if (any(greaterThanEqual(p, size))) return;
    vec3 e = imageLoad(src, p).rgb;
    if (pc.sharpness <= 0.0) {
        imageStore(dst, p, vec4(e, 1.0));
        return;
    }
    ivec2 hi = size - 1;
    vec3 a = imageLoad(src, clamp(p + ivec2(-1, -1), ivec2(0), hi)).rgb;
    vec3 b = imageLoad(src, clamp(p + ivec2(0, -1), ivec2(0), hi)).rgb;
    vec3 c = imageLoad(src, clamp(p + ivec2(1, -1), ivec2(0), hi)).rgb;
    vec3 d = imageLoad(src, clamp(p + ivec2(-1, 0), ivec2(0), hi)).rgb;
    vec3 f = imageLoad(src, clamp(p + ivec2(1, 0), ivec2(0), hi)).rgb;
    vec3 g = imageLoad(src, clamp(p + ivec2(-1, 1), ivec2(0), hi)).rgb;
    vec3 h = imageLoad(src, clamp(p + ivec2(0, 1), ivec2(0), hi)).rgb;
    vec3 i = imageLoad(src, clamp(p + ivec2(1, 1), ivec2(0), hi)).rgb;

    // Soft min/max over the cross plus the diagonals.
    vec3 mnCross = min(min(min(d, e), min(f, b)), h);
    vec3 mxCross = max(max(max(d, e), max(f, b)), h);
    vec3 mn = mnCross + min(mnCross, min(min(a, c), min(g, i)));
    vec3 mx = mxCross + max(mxCross, max(max(a, c), max(g, i)));

    // Amount: high in flat/low-contrast areas, low near strong edges.
    vec3 amp = sqrt(clamp(min(mn, 2.0 - mx) / max(mx, vec3(1e-5)), 0.0, 1.0));
    float peak = -1.0 / mix(8.0, 5.0, clamp(pc.sharpness, 0.0, 1.0));
    vec3 w = amp * peak;
    vec3 outc = ((b + d + f + h) * w + e) / (1.0 + 4.0 * w);
    imageStore(dst, p, vec4(clamp(outc, 0.0, 1.0), 1.0));
}
