#version 460
#extension GL_GOOGLE_include_directive : require
#ifdef SER
#extension GL_NV_shader_invocation_reorder : require
#endif
#include "rt.glsl"
#include "atmosphere.glsl"

// Akari's path tracer: one path per pixel per frame, denoised by DLSS Ray Reconstruction (or
// accumulated by TAA). At every vertex: next-event estimation of the sun, the moon and the
// analytic lights (resampled importance sampling over a few candidates), then a GGX / Lambert
// (+ foliage transmission) bounce chosen by one-sample MIS between the lobes. Escaping rays read
// the sky map (sky.comp). Radiance is written pre-exposed (g.sky.w) so night and day both fit the
// 16-bit targets.

layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D curImg;
layout(set = 0, binding = 2, r32f) uniform writeonly image2D depthImg;
// DLSS Ray Reconstruction guides (written when g.opts.y = 1)
layout(set = 0, binding = 8, r32f) uniform writeonly image2D viewzImg;
layout(set = 0, binding = 9, rg16f) uniform writeonly image2D motionImg;
layout(set = 0, binding = 10, rgba16f) uniform writeonly image2D normalImg;
layout(set = 0, binding = 11, rgba8) uniform writeonly image2D diffImg;
layout(set = 0, binding = 12, rgba8) uniform writeonly image2D specImg;

layout(location = 0) rayPayloadEXT Hit pl;
layout(location = 1) rayPayloadEXT uint vis;

const float FAR = 2.0e4;
const float SUN_RADIUS = 0.00465;   // angular radius (rad)
const float MOON_RADIUS = 0.0045;
const float SUN_SOLID_ANGLE = 6.8e-5;

uint rng;

vec3 skyLookup(vec3 d) {
    return textureLod(skyLut, octEncode(d) * 0.5 + 0.5, 0.0).rgb;
}

float traceVis(vec3 o, vec3 d, float tmax) {
    vis = 0u;
    // (mask 0xF9: not the glass (0x02), which light passes straight through, nor water (0x04):
    // what light loses under water is reckoned where it lands: waterSunlight)
    traceRayEXT(tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT, 0xF9, 0, 0, 1, o, 0.0, d, tmax, 1);
    return float(vis);
}

// A direction inside the cone of angular radius r around d (soft shadows of the sun / moon disc).
vec3 coneSample(vec3 d, float r) {
    vec3 t, b;
    basis(d, t, b);
    float u = rnd(rng), v = rnd(rng);
    float ct = 1.0 - u * (1.0 - cos(r));
    float st = sqrt(max(1.0 - ct * ct, 0.0));
    float ph = 2.0 * PI * v;
    return normalize(t * (st * cos(ph)) + b * (st * sin(ph)) + d * ct);
}

// ---------------------------------------------------------------- BRDF
struct Surf {
    vec3 n;
    vec3 ng;
    vec3 diff;   // diffuse albedo
    vec3 F0;
    float a;     // GGX alpha (roughness^2)
    float trans; // foliage transmission (0 = opaque)
    float ks;    // specular scale: 1, less on bare matte ground (dry soil has no grazing sheen)
};

float D_ggx(float NdH, float a) {
    float a2 = a * a;
    float d = NdH * NdH * (a2 - 1.0) + 1.0;
    return a2 / (PI * d * d);
}
float G1_smith(float NdX, float a) {
    float a2 = a * a;
    return 2.0 * NdX / (NdX + sqrt(a2 + (1.0 - a2) * NdX * NdX));
}
vec3 F_schlick(vec3 F0, float c) {
    return F0 + (1.0 - F0) * pow(1.0 - c, 5.0);
}

// BRDF x cos for light arriving from L (also through a leaf from behind).
vec3 brdfCos(Surf s, vec3 V, vec3 L) {
    float NdL = dot(s.n, L);
    float NdV = max(dot(s.n, V), 1e-4);
    if (NdL <= 0.0) {
        // diffuse transmission through thin foliage
        return s.trans > 0.0 ? s.diff * (s.trans * INV_PI * -NdL) : vec3(0.0);
    }
    vec3 H = normalize(V + L);
    float NdH = max(dot(s.n, H), 0.0), VdH = max(dot(V, H), 0.0);
    vec3 F = F_schlick(s.F0, VdH) * s.ks;
    float D = D_ggx(NdH, s.a);
    float G = G1_smith(NdL, s.a) * G1_smith(NdV, s.a);
    vec3 spec = F * (D * G / (4.0 * NdV));          // x NdL / NdL
    vec3 diff = s.diff * (1.0 - F) * (1.0 - s.trans) * INV_PI * NdL;
    return diff + spec;
}

// ---------------------------------------------------------------- water (MAT_WATER)
const float WATER_IOR = 1.333;
// absorption per metre: pool water loses red first, then green (its blue-green), a touch
// stronger than pure water for the chlorine and the fine silt a school pool holds
const vec3 WATER_SIGMA = vec3(0.32, 0.052, 0.03);
// sunlight scattered back out of the water by fine particles, per metre (its milky turquoise)
const vec3 WATER_SCATTER = vec3(0.0015, 0.006, 0.01);

// The surface's ripples at x (world xz, m), time t (s): a sum of directional waves, a light
// breeze over a still pool, on deep-water dispersion. Waves finer than the pixel's footprint fp
// (m) fade out. Height (m), its gradient and its Laplacian (for the caustics).
void waterWaves(vec2 x, float t, float fp, out float h, out vec2 grad, out float lap) {
    // (direction deg, wavelength m, amplitude m)
    // (the fine ripples, which make the caustics, spread round the compass: an even net of light,
    // not stripes)
    const vec3 W[10] = vec3[10](vec3(20.0, 2.3, 0.006), vec3(-35.0, 1.4, 0.0045), vec3(75.0, 0.93, 0.0032),
                                vec3(160.0, 0.61, 0.0022), vec3(-110.0, 0.43, 0.0015), vec3(5.0, 0.29, 0.0009),
                                vec3(65.0, 0.23, 0.0004), vec3(125.0, 0.18, 0.0003), vec3(-170.0, 0.14, 0.0002),
                                vec3(-55.0, 0.11, 0.00012));
    h = 0.0;
    grad = vec2(0.0);
    lap = 0.0;
    for (int i = 0; i < 10; ++i) {
        float a = radians(W[i].x);
        vec2 d = vec2(cos(a), sin(a));
        float k = 6.2831853 / W[i].y;
        // (a wave only a few pixels long would flicker from sample to sample: fade it out first)
        float amp = W[i].z * (1.0 - smoothstep(0.05, 0.25, fp * k));
        float ph = k * dot(d, x) - sqrt(9.81 * k) * t + float(i) * 1.7;
        float sn = sin(ph), cs = cos(ph);
        h += amp * sn;
        grad += amp * k * cs * d;
        lap -= amp * k * k * sn;
    }
}

// One layer of the caustic net at x (in cells): bright filaments along the borders between
// jittered cells whose points wander in small circles with time. The border is where light
// refracted by two neighbouring ripples crosses: its distance (F2 - F1) sets the line.
float causticNet(vec2 x, float t, float w) {
    vec2 c = floor(x), f = fract(x);
    float d1 = 8.0, d2 = 8.0;
    for (int j = -1; j <= 1; ++j) {
        for (int i = -1; i <= 1; ++i) {
            vec2 o = vec2(i, j);
            uint h = hash2(uvec2(ivec2(c + o) + 4096));
            vec2 r = vec2(float(h & 0xFFFFu), float(h >> 16)) / 65535.0;
            float ph = 6.2831853 * r.x + t * (0.6 + 0.5 * r.y);
            vec2 q = o + 0.5 + 0.32 * vec2(cos(ph), sin(ph * 1.3 + r.y * 4.0)) - f;
            float d = dot(q, q);
            if (d < d1) { d2 = d1; d1 = d; } else if (d < d2) { d2 = d; }
        }
    }
    float e = sqrt(d2) - sqrt(d1);
    return exp(-e / w);
}

// Sunlight reaching p, under the surface at height wy, from L: what the water let through
// (Fresnel at the surface, absorption on the way down) and the ripples' caustics: a net of thin
// bright lines over an evenly lit floor (energy moved into the lines from the cells between).
vec3 waterSunlight(vec3 p, vec3 L, float wy, float fp) {
    float d = max(wy - p.y, 0.0);
    float ly = max(L.y, 0.05);
    vec2 xs = p.xz + L.xz * (d / ly);
    float h, lap;
    vec2 gr;
    waterWaves(xs, g.camPos.w, fp, h, gr, lap);
    // (the net wobbles with the bigger waves that carry the ripples)
    vec2 x = xs + gr * d * 2.5;
    float t = g.camPos.w;
    // two layers turned against each other at unrelated scales (their cell grids never line up:
    // no repeat), and how strong the net is drifting over metres (the breeze isn't even)
    const mat2 R1 = mat2(0.809, 0.588, -0.588, 0.809), R2 = mat2(0.342, -0.940, 0.940, 0.342);
    float n1 = causticNet(R1 * x / 0.437 + 3.1, t * 1.1, 0.07);
    float n2 = causticNet(R2 * x / 0.263 + 17.3, t * 1.5, 0.09);
    float h2, l2;
    vec2 g2;
    waterWaves(x * 0.13 + 40.0, t * 0.3, 0.0, h2, g2, l2);
    float drift = clamp(0.75 + 60.0 * h2, 0.35, 1.15);
    // finer than the pixel: the lines melt into their mean
    float vis = (1.0 - smoothstep(0.015, 0.08, fp / 0.263)) * smoothstep(0.05, 0.45, d) * drift;
    float net = 0.62 * n1 + 0.38 * n2 * (0.6 + 0.8 * n1);
    float I = mix(1.0, 0.72 + 1.6 * net, vis);
    float F = 0.02 + 0.98 * pow(1.0 - ly, 5.0);
    return (1.0 - F) * exp(-WATER_SIGMA * (d / ly)) * I;
}

// The way to the sun from p under the water (surface at wy): bent by the ripple above as the
// light came through it, and spread by the water's forward scattering, wider the deeper p lies.
// The shadows of things in and over the water (the lane ropes, a swimmer) wobble with the waves
// and soften with depth, as they do on a pool's floor.
vec3 underwaterSun(vec3 p, float wy, float fp) {
    vec3 S = g.sunDir.xyz;
    float d = max(wy - p.y, 0.0);
    float h, lap;
    vec2 gr;
    waterWaves(p.xz + S.xz * (d / max(S.y, 0.05)), g.camPos.w, fp, h, gr, lap);
    // (refraction turns the light by about (1 - 1/n) of the surface's tilt; the ripples' slopes
    // are small, so their sway on the floor is shown at a few times that)
    vec3 bent = normalize(S + vec3(-gr.x, 0.0, -gr.y) * 3.0 * (1.0 - 1.0 / WATER_IOR));
    return coneSample(bent, SUN_RADIUS + 0.035 * clamp(d, 0.0, 2.0));
}

// What the water mirrors along d from o, shaded simply (sun with its shadow, sky light, glow):
// the reflection is a few percent of what the eye gets, so one plain bounce shows the fence,
// the hills and the sky in it without the noise of choosing reflection or refraction at random.
vec3 waterReflection(vec3 o, vec3 d, vec3 Esun) {
    pl.t = -1.0;
    pl.cone = vec2(0.002, 0.0);
    pl.prev = vec4(0.0);
    pl.sunVis = 1.0;
    // (mask 0xF9: not the water itself, nor glass)
    traceRayEXT(tlas, gl_RayFlagsNoneEXT, 0xF9, 0, 0, 0, o, 0.0, d, FAR, 0);
    if (pl.t < 0.0) return skyLookup(d);
    vec3 n = dot(pl.n, d) > 0.0 ? -pl.n : pl.n;
    vec3 q = o + d * pl.t;
    vec3 c = pl.emission;
    vec3 alb = pl.albedo * (1.0 - pl.metallic);
    float ndl = dot(n, g.sunDir.xyz);
    if (g.sunDir.w > 0.0 && ndl > 0.0)
        c += alb * INV_PI * ndl * Esun * traceVis(q + n * (1e-3 + pl.t * 2e-5), g.sunDir.xyz, FAR);
    c += alb * skyLookup(normalize(n + vec3(0.0, 0.6, 0.0))) * 0.75;
    return c;
}

// Probability of sampling the specular lobe.
float specProb(Surf s, vec3 V) {
    float NdV = max(dot(s.n, V), 1e-4);
    float fs = luminance(F_schlick(s.F0, NdV)) * s.ks;
    float fd = luminance(s.diff);
    return clamp(fs / max(fs + fd, 1e-4), 0.1, 0.95);
}

// GGX visible normal sampling (Heitz 2018), in the tangent frame of n.
vec3 sampleGGXVNDF(vec3 Ve, float a, float u1, float u2) {
    vec3 Vh = normalize(vec3(a * Ve.x, a * Ve.y, Ve.z));
    float lensq = Vh.x * Vh.x + Vh.y * Vh.y;
    vec3 T1 = lensq > 0.0 ? vec3(-Vh.y, Vh.x, 0.0) * inversesqrt(lensq) : vec3(1.0, 0.0, 0.0);
    vec3 T2 = cross(Vh, T1);
    float r = sqrt(u1);
    float phi = 2.0 * PI * u2;
    float t1 = r * cos(phi);
    float t2 = r * sin(phi);
    float sh = 0.5 * (1.0 + Vh.z);
    t2 = (1.0 - sh) * sqrt(max(1.0 - t1 * t1, 0.0)) + sh * t2;
    vec3 Nh = t1 * T1 + t2 * T2 + sqrt(max(0.0, 1.0 - t1 * t1 - t2 * t2)) * Vh;
    return normalize(vec3(a * Nh.x, a * Nh.y, max(0.0, Nh.z)));
}

float pdfSpec(Surf s, vec3 V, vec3 L) {
    float NdV = max(dot(s.n, V), 1e-4);
    vec3 H = normalize(V + L);
    float NdH = max(dot(s.n, H), 0.0);
    return G1_smith(NdV, s.a) * D_ggx(NdH, s.a) / (4.0 * NdV);
}
float pdfDiff(Surf s, vec3 L) {
    float c = dot(s.n, L);
    float pt = s.trans > 0.0 ? s.trans / (1.0 + s.trans) : 0.0;
    return c >= 0.0 ? (1.0 - pt) * c * INV_PI : pt * -c * INV_PI;
}

// Next direction; returns BRDF x cos / pdf (zero if the sample is invalid).
vec3 sampleBrdf(Surf s, vec3 V, out vec3 L) {
    vec3 t, b;
    basis(s.n, t, b);
    float ps = specProb(s, V);
    float u = rnd(rng);
    if (u < ps) {
        vec3 Ve = vec3(dot(V, t), dot(V, b), dot(V, s.n));
        vec3 Hl = sampleGGXVNDF(Ve, s.a, rnd(rng), rnd(rng));
        vec3 H = t * Hl.x + b * Hl.y + s.n * Hl.z;
        L = reflect(-V, H);
        if (dot(L, s.n) <= 0.0) return vec3(0.0);
    } else {
        float u1 = rnd(rng), u2 = rnd(rng);
        float r = sqrt(u1), phi = 2.0 * PI * u2;
        vec3 d = t * (r * cos(phi)) + b * (r * sin(phi)) + s.n * sqrt(max(0.0, 1.0 - u1));
        float pt = s.trans > 0.0 ? s.trans / (1.0 + s.trans) : 0.0;
        L = rnd(rng) < pt ? -d : d;
    }
    float pdf = ps * (dot(L, s.n) > 0.0 ? pdfSpec(s, V, L) : 0.0) + (1.0 - ps) * pdfDiff(s, L);
    if (pdf <= 1e-6) return vec3(0.0);
    return brdfCos(s, V, L) / pdf;
}

// Pre-integrated specular albedo (Karis' analytic fit), for the DLSS guide.
vec3 envBRDF(vec3 F0, float NoV, float rough) {
    const vec4 c0 = vec4(-1.0, -0.0275, -0.572, 0.022);
    const vec4 c1 = vec4(1.0, 0.0425, 1.04, -0.04);
    vec4 r = rough * c0 + c1;
    float a004 = min(r.x * r.x, exp2(-9.28 * NoV)) * r.x + r.y;
    vec2 AB = vec2(-1.04, 1.04) * a004 + r.zw;
    return F0 * AB.x + AB.y;
}

// ---------------------------------------------------------------- lights
float lightWindow(float d, float range) {
    float x = d / max(range, 1e-3);
    float w = clamp(1.0 - x * x * x * x, 0.0, 1.0);
    return w * w;
}

// Unshadowed irradiance-like weight of light i at p (target function for resampling).
vec3 lightContrib(uint i, vec3 p, vec3 lp, out vec3 L, out float dist) {
    Light li = lights[i];
    vec3 d = lp - p;
    dist = length(d);
    L = d / max(dist, 1e-4);
    float att = lightWindow(dist, li.color.w) / max(dist * dist, li.posRadius.w * li.posRadius.w + 1e-4);
    if (li.spot.w > -1.0) {
        float c = dot(-L, li.spot.xyz);
        att *= smoothstep(li.spot.w, min(li.spot.w + 0.12, 1.0), c);
    }
    return li.color.rgb * att;
}

// Resampled importance sampling over M uniform candidates: one light, with its estimator weight.
vec3 sampleLights(Surf s, vec3 p, vec3 V) {
    uint count = g.frame.z;
    if (count == 0u) return vec3(0.0);
    const int M = 8;
    float wsum = 0.0;
    uint pick = 0u;
    float pickHat = 0.0;
    for (int k = 0; k < M; ++k) {
        uint i = min(uint(rnd(rng) * float(count)), count - 1u);
        vec3 L;
        float dist;
        vec3 c = lightContrib(i, p, lights[i].posRadius.xyz, L, dist);
        float cosw = dot(s.n, L) > 0.0 ? dot(s.n, L) : (s.trans > 0.0 ? -dot(s.n, L) * s.trans : 0.0);
        float hat = luminance(c) * cosw;
        wsum += hat;
        if (hat > 0.0 && rnd(rng) * wsum < hat) {
            pick = i;
            pickHat = hat;
        }
    }
    if (pickHat <= 0.0) return vec3(0.0);
    // a point on the emitter's sphere for soft shadows
    Light li = lights[pick];
    vec3 lp = li.posRadius.xyz + (vec3(rnd(rng), rnd(rng), rnd(rng)) * 2.0 - 1.0) * li.posRadius.w * 0.577;
    vec3 L;
    float dist;
    vec3 c = lightContrib(pick, p, lp, L, dist);
    vec3 f = brdfCos(s, V, L);
    if (luminance(f) <= 0.0) return vec3(0.0);
    float W = wsum * float(count) / (float(M) * pickHat);
    vec3 o = p + s.ng * (dot(L, s.ng) >= 0.0 ? 2e-3 : -2e-3);
    float v = traceVis(o, L, max(dist - li.posRadius.w - 0.01, 0.0));
    return f * c * W * v;
}

// ---------------------------------------------------------------- sky as seen directly
vec3 primarySky(vec3 d, vec3 Tsun, vec3 Tmoon) {
    vec3 c = skyLookup(d);
    // sun disc (with limb darkening), through the atmosphere
    float cs = dot(d, g.sunDir.xyz);
    if (g.sunDir.w > 0.0 && cs > cos(SUN_RADIUS)) {
        float r = sqrt(max(1.0 - cs * cs, 0.0)) / sin(SUN_RADIUS);
        float limb = 1.0 - 0.6 * (1.0 - sqrt(max(1.0 - r * r, 0.0)));
        c += min(g.sunDir.w / SUN_SOLID_ANGLE * limb, 3.0e4 / max(g.sky.w, 1e-9)) * Tsun;
    }
    // moon disc lit by the sun (phase): a sphere seen from here
    float cm = dot(d, g.moonDir.xyz);
    if (cm > cos(MOON_RADIUS) && g.moonDir.y > -0.02) {
        vec3 side = d - g.moonDir.xyz * cm;
        float r = clamp(length(side) / sin(MOON_RADIUS), 0.0, 1.0);
        vec3 nrm = normalize(side / sin(MOON_RADIUS) - g.moonDir.xyz * sqrt(1.0 - r * r));
        // sun direction as seen at the moon: the real sun direction
        // (lit by the true sun direction, so the terminator shows the phase; a faint earthshine)
        float lit = max(dot(nrm, g.sunDir.xyz), 0.0) + 0.01;
        // the disc's radiance: the moon's irradiance (g.moonDir.w, already scaled by the phase)
        // spread over its solid angle, doubled because only the lit part shines
        c += vec3(0.9, 0.92, 1.0) * lit * 2.0 * g.moonDir.w / SUN_SOLID_ANGLE * Tmoon;
    }
    // stars: a fixed field, fading near the horizon and in daylight
    if (d.y > 0.0 && g.sky.y > 0.0) {
        vec3 q = d * 420.0;
        uint h = hash2(uvec2(ivec2(floor(q.xz) + 4096.0)) ^ uvec2(uint(floor(q.y + 512.0)) * 7919u));
        float s = float(h & 0xFFFFu) / 65535.0;
        if (s > 0.9965) {
            float mag = pow((s - 0.9965) / 0.0035, 3.0);
            c += vec3(0.85, 0.9, 1.0) * mag * g.sky.y * smoothstep(0.0, 0.25, d.y) * 2.0e-5;
        }
    }
    return c;
}

// ---------------------------------------------------------------- main
void main() {
    uvec2 px = gl_LaunchIDEXT.xy;
    uvec2 size = gl_LaunchSizeEXT.xy;
    rng = hash2(px) ^ pcg(g.frame.x * 9781u + 17u);
    uint still = g.frame.y;
    uint dbg = g.frame.w;
    bool guides = g.opts.y != 0u;

    // Still camera without DLSS: random sub-pixel positions accumulate into a supersampled image.
    vec2 jitter = (still > 0u && !guides) ? vec2(rnd(rng), rnd(rng)) : taaJitter(g.frame.x);
    vec2 ndc = (vec2(px) + jitter) / vec2(size) * 2.0 - 1.0;
    vec3 dir = normalize(g.camFwd.xyz + g.camRight.xyz * (ndc.x * g.camRight.w) - g.camUp.xyz * (ndc.y * g.camUp.w));
    vec3 org = g.camPos.xyz;
    vec3 dir0 = dir;

    vec3 ro = vec3(0.0, R_GROUND + max(g.sky.x, 1.0), 0.0);
    vec3 Tsun = g.sunDir.w > 0.0 ? extinction(lightDepth(ro, g.sunDir.xyz)) : vec3(0.0);
    vec3 Tmoon = extinction(lightDepth(ro, g.moonDir.xyz));
    vec3 Esun = g.sunDir.w * Tsun;
    vec3 Emoon = g.moonDir.w * Tmoon * vec3(0.85, 0.9, 1.0);

    vec3 radiance = vec3(0.0);
    vec3 thr = vec3(1.0);
    float spread = g.camFwd.w, width = 0.0;
    float t0 = -1.0;
    vec4 prev0 = vec4(0.0); // first hit's position last frame (object motion), w = 1 when known
    vec3 gbN = -dir, gbDiff = vec3(0.0), gbSpec = vec3(0.0);
    float gbRough = 1.0;
    vec3 firstAlbedo = vec3(0.0), firstN = vec3(0.0);
    uint maxB = g.opts.x;
    uint glassPasses = 0u;
    // under water: since the ray last crossed a water surface downwards (wy: that surface's height)
    bool inWater = false;
    float wy = 0.0;
    uint waterPasses = 0u;
    bool waterMirror = false;   // the camera's ray reflected off water: the sun's disc is in its glints
    // distance travelled through glass before the first real hit: the guides' depth (and so the
    // motion vectors) are measured from the camera, not from the pane
    float tGlass = 0.0;

    for (uint b = 0u; b <= maxB; ++b) {
        pl.t = -1.0;
        pl.cone = vec2(spread, width);
        pl.prev = vec4(0.0);
        pl.sunVis = 1.0;
#ifdef SER
        if (b == 0u) {
            hitObjectNV hobj;
            hitObjectTraceRayNV(hobj, tlas, gl_RayFlagsNoneEXT, 0xFF, 0, 0, 0, org, 0.0, dir, FAR, 0);
            reorderThreadNV(hobj);
            hitObjectExecuteShaderNV(hobj, 0);
        } else {
            // (bounces see through glass: mask 0xFD; only what the camera sees stops at it)
            traceRayEXT(tlas, gl_RayFlagsNoneEXT, 0xFD, 0, 0, 0, org, 0.0, dir, FAR, 0);
        }
#else
        traceRayEXT(tlas, gl_RayFlagsNoneEXT, b == 0u ? 0xFFu : 0xFDu, 0, 0, 0, org, 0.0, dir, FAR, 0);
#endif
        if (pl.t < 0.0) {
            vec3 sky = (b == 0u && !waterMirror) ? primarySky(dir, Tsun, Tmoon) : skyLookup(dir);
            vec3 add = thr * sky;
            if (b > 0u) add = min(add, vec3(64.0 / max(g.sky.w, 1e-9)));
            radiance += add;
            break;
        }
        vec3 p = org + dir * pl.t;
        width += spread * pl.t;
        vec3 V = -dir;
        Surf s;
        s.n = pl.n;
        s.ng = pl.ng;
        s.a = max(pl.roughness * pl.roughness, 0.0004);
        s.diff = pl.albedo * (1.0 - pl.metallic);
        s.F0 = mix(vec3(0.04), pl.albedo, pl.metallic);
        // (terrain: dry soil and dust scatter light back rather than glancing off: a rough
        // microfacet lobe with full Schlick Fresnel turns the ground to a sheen against a low sun)
        s.ks = (pl.flags & MAT_GROUND) != 0u ? 1.0 - 0.85 * smoothstep(0.85, 1.0, pl.roughness) : 1.0;
        s.trans = (pl.flags & MAT_FOLIAGE) != 0u ? clamp(pl.transmission, 0.0, 0.9) : 0.0;
        uint flags = pl.flags;
        vec3 emission = pl.emission;
        float ao = pl.ao;
        float selfSun = pl.sunVis;

        // a water surface: reflect or refract (Fresnel, chosen at random; the camera's rays split
        // more evenly so both the reflection and the floor below clear quickly). Doesn't use up a
        // bounce.
        if ((flags & MAT_WATER) != 0u && waterPasses < 8u) {
            waterPasses++;
            if (b == 0u) tGlass += pl.t;
            if (inWater) {
                // (up from under the water: its colour on the way)
                vec3 T = exp(-WATER_SIGMA * pl.t);
                radiance += thr * WATER_SCATTER * (1.0 - T) / WATER_SIGMA * (Esun * 0.5 + Emoon * 0.5);
                thr *= T;
            }
            float wh, wl;
            vec2 wg;
            waterWaves(p.xz, g.camPos.w, width, wh, wg, wl);
            vec3 nw = normalize(vec3(-wg.x, 1.0, -wg.y));
            bool down = dir.y < 0.0;
            // the sun's glints: its disc mirrored in the ripples, drawn analytically (a narrow GGX
            // lobe round each ripple's normal) so they sparkle without fireflies
            if (b == 0u && down && g.sunDir.w > 0.0) {
                vec3 S = g.sunDir.xyz;
                float NdL = dot(nw, S), NdV = max(dot(nw, V), 1e-3);
                if (NdL > 0.0) {
                    vec3 H = normalize(V + S);
                    float ag = 0.012 + 0.6 * width;     // (wider where a pixel spans many ripples)
                    float D = D_ggx(max(dot(nw, H), 0.0), ag);
                    float G = G1_smith(NdL, ag) * G1_smith(NdV, ag);
                    float Fg = 0.02 + 0.98 * pow(1.0 - max(dot(V, H), 0.0), 5.0);
                    vec3 o = p + vec3(0.0, 1e-3 + pl.t * 2e-5, 0.0);
                    radiance += thr * Esun * Fg * D * G / (4.0 * NdV) * traceVis(o, coneSample(S, SUN_RADIUS), FAR);
                }
            }
            vec3 nf = down ? nw : -nw;
            vec3 up = vec3(0.0, 1.0, 0.0);
            vec3 tdir = refract(dir, nf, down ? 1.0 / WATER_IOR : WATER_IOR);
            bool tir = dot(tdir, tdir) < 0.5;
            // (Schlick on the angle in the air: the incoming one from above, the refracted one from below)
            float ca = down ? clamp(-dot(dir, nf), 0.0, 1.0) : clamp(abs(dot(tdir, nf)), 0.0, 1.0);
            float F = tir ? 1.0 : 0.02 + 0.98 * pow(1.0 - ca, 5.0);
            vec3 off = up * (1e-3 + pl.t * 2e-5);
            // seen from above, the camera's ray goes through every time and takes the reflection
            // with it, traced and shaded once (waterReflection): a random choice between the two
            // left speckle near (every eighth pixel dark) and far (where reflection is strong)
            // that the denoiser can't clear
            if (b == 0u && down && !tir) {
                vec3 rd = reflect(dir, nf);
                if (rd.y < 0.0) rd.y = -rd.y;
                radiance += thr * F * waterReflection(p + off, rd, Esun);
                thr *= 1.0 - F;
                dir = tdir;
                if (dir.y > 0.0) dir.y = -dir.y;
                org = p - off;
                inWater = true;
                wy = p.y;
                b--;
                continue;
            }
            float P = (b == 0u && !tir) ? clamp(F, 0.12, 0.88) : F;
            if (rnd(rng) < P) {
                thr *= F / P;
                if (b == 0u) waterMirror = true;
                dir = reflect(dir, nf);
                // (a steep ripple can't throw the ray through the surface it bounced off)
                if (down == (dir.y < 0.0)) dir.y = -dir.y;
                org = down ? p + off : p - off;
            } else {
                thr *= (1.0 - F) / (1.0 - P);
                dir = tdir;
                if (down == (dir.y > 0.0)) dir.y = -dir.y;
                org = down ? p - off : p + off;
                inWater = down;
                if (down) wy = p.y;
            }
            b--; // (uint wraps; the loop's ++ restores it)
            continue;
        }
        // reached something under the water: the water's colour on the way there
        if (inWater) {
            vec3 T = exp(-WATER_SIGMA * pl.t);
            radiance += thr * WATER_SCATTER * (1.0 - T) / WATER_SIGMA * (Esun * 0.5 + Emoon * 0.5);
            thr *= T;
        }

        // thin clear glass: reflect (Fresnel) or pass straight through, tinted; doesn't use up a
        // bounce (the surface behind is the first hit for the guides)
        if ((flags & MAT_GLASS) != 0u && glassPasses < 6u) {
            glassPasses++;
            if (b == 0u) tGlass += pl.t;
            radiance += thr * emission;
            float c = clamp(abs(dot(s.n, V)), 0.0, 1.0);
            float F = 0.04 + 0.96 * pow(1.0 - c, 5.0);
            vec3 nf = dot(s.ng, V) >= 0.0 ? s.ng : -s.ng;
            if (b == 0u) {
                // seen directly: through, with the sky's reflection added (no noisy split)
                radiance += thr * F * skyLookup(reflect(dir, dot(s.n, V) >= 0.0 ? s.n : -s.n));
                thr *= (1.0 - F) * mix(vec3(1.0), pl.albedo, 0.15) * 0.97;
                org = p - nf * (1e-4 + pl.t * 2e-5);
            } else if (rnd(rng) < F) {
                dir = reflect(dir, dot(s.n, V) >= 0.0 ? s.n : -s.n);
                org = p + nf * (1e-4 + pl.t * 2e-5);
            } else {
                thr *= mix(vec3(1.0), pl.albedo, 0.15) * 0.97;
                org = p - nf * (1e-4 + pl.t * 2e-5);
            }
            b--; // (uint wraps; the loop's ++ restores it)
            continue;
        }

        if (b == 0u) {
            t0 = tGlass + pl.t;
            prev0 = pl.prev;
            float NdV = max(dot(s.n, V), 1e-4);
            gbN = s.n;
            gbRough = pl.roughness;
            gbDiff = s.diff;
            gbSpec = envBRDF(s.F0, NdV, pl.roughness) * s.ks;
            firstAlbedo = pl.albedo;
            firstN = s.n;
        }
        if (dbg == 1u) { radiance = firstAlbedo; break; }
        if (dbg == 2u) { radiance = firstN * 0.5 + 0.5; break; }

        if (b == 0u || (flags & MAT_UNLIT_EMISSIVE) == 0u) radiance += thr * emission;

        vec3 direct = vec3(0.0);
        vec3 po = p + s.ng * (1e-3 + pl.t * 2e-5);
        // the sun
        if (g.sunDir.w > 0.0 && (dot(s.n, g.sunDir.xyz) > 0.0 || s.trans > 0.0)) {
            vec3 L = inWater ? underwaterSun(p, wy, width) : coneSample(g.sunDir.xyz, SUN_RADIUS);
            vec3 f = brdfCos(s, V, L);
            if (luminance(f) > 0.0) {
                vec3 o = dot(L, s.ng) >= 0.0 ? po : p - s.ng * (1e-3 + pl.t * 2e-5);
                vec3 sw = inWater ? waterSunlight(p, g.sunDir.xyz, wy, width) : vec3(1.0);
                direct += f * Esun * sw * selfSun * traceVis(o, L, FAR);
            }
        }
        // the moon
        if (g.moonDir.w > 0.0 && g.moonDir.y > 0.0 && (dot(s.n, g.moonDir.xyz) > 0.0 || s.trans > 0.0)) {
            vec3 L = coneSample(g.moonDir.xyz, MOON_RADIUS);
            vec3 f = brdfCos(s, V, L);
            if (luminance(f) > 0.0) {
                vec3 o = dot(L, s.ng) >= 0.0 ? po : p - s.ng * (1e-3 + pl.t * 2e-5);
                vec3 mw = inWater ? waterSunlight(p, L, wy, width) : vec3(1.0);
                direct += f * Emoon * mw * traceVis(o, L, FAR);
            }
        }
        // lamps, windows, vending machines
        direct += sampleLights(s, p, V);
        if (b > 0u) direct = min(direct, vec3(32.0 / max(g.sky.w, 1e-9)));
        radiance += thr * direct;

        if (b == maxB) break;
        vec3 L;
        vec3 wgt = sampleBrdf(s, V, L);
        if (luminance(wgt) <= 0.0) break;
        // material occlusion darkens the indirect light the surface receives
        thr *= wgt * mix(1.0, ao, 0.8);
        if (b >= 1u) {
            float q = clamp(max(thr.r, max(thr.g, thr.b)), 0.05, 0.95);
            if (rnd(rng) > q) break;
            thr /= q;
        }
        org = p + s.ng * (dot(L, s.ng) >= 0.0 ? 1.0 : -1.0) * (1e-3 + pl.t * 2e-5);
        dir = L;
        // a bounce widens the ray cone (blurrier texture lookups further down the path)
        spread = max(spread, 0.25 * pl.roughness + 0.02);
    }

    // Aerial haze over the first hit (cheap: the sky's horizon light, Rayleigh-coloured extinction).
    if (t0 > 0.0 && g.fog.x > 0.0 && dbg == 0u) {
        vec3 beta = (vec3(5.8e-6, 13.5e-6, 33.1e-6) + 4.0e-6) * g.fog.x;
        vec3 T = exp(-beta * t0);
        vec3 hz = skyLookup(normalize(vec3(dir0.x, max(dir0.y, 0.02), dir0.z)));
        radiance = radiance * T + hz * (1.0 - T);
    }

    vec3 outc = radiance * g.sky.w;
    if (dbg == 1u || dbg == 2u) outc = radiance;
    imageStore(curImg, ivec2(px), vec4(min(outc, vec3(6.0e4)), 1.0));
    imageStore(depthImg, ivec2(px), vec4(t0 < 0.0 ? 10.0 * FAR : t0));
    if (guides) {
        vec4 X = t0 < 0.0 ? vec4(dir0, 0.0) : vec4(g.camPos.xyz + dir0 * t0, 1.0);
        vec2 sz = vec2(size);
        vec2 cur = projectPx(X, g.camPos, g.camRight, g.camUp, g.camFwd, sz);
        // a moving object: where this surface point was last frame (else it sat still)
        vec4 Xp = (t0 >= 0.0 && prev0.w > 0.5) ? vec4(prev0.xyz, 1.0) : X;
        vec2 prev = projectPx(Xp, g.prevPos, g.prevRight, g.prevUp, g.prevFwd, sz);
        imageStore(motionImg, ivec2(px), vec4(prev - cur, 0.0, 0.0));
        imageStore(viewzImg, ivec2(px), vec4(t0 < 0.0 ? 10.0 * FAR : t0 * dot(dir0, g.camFwd.xyz)));
        imageStore(normalImg, ivec2(px), vec4(gbN, gbRough));
        imageStore(diffImg, ivec2(px), vec4(clamp(gbDiff, 0.0, 1.0), 1.0));
        imageStore(specImg, ivec2(px), vec4(clamp(gbSpec, 0.0, 1.0), 1.0));
    }
}
