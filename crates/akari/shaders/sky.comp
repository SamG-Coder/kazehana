#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "atmosphere.glsl"

// The sky as seen from the camera, once per frame, into an octahedral map (common.glsl
// octEncode): physically based single scattering of the sun and the moon (atmosphere.glsl,
// ported from SmartImposter), plus faint airglow. The sun and moon discs are not in it (the ray
// generation shader draws them and samples them as lights). Bounce rays that escape read their
// light from here; below the horizon it is the ground's glow.

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D lut;
layout(set = 0, binding = 1) uniform GlobalsUBO { Globals g; };

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(lut);
    if (any(greaterThanEqual(p, size))) return;
    vec3 d = octDecode((vec2(p) + 0.5) / vec2(size) * 2.0 - 1.0);

    vec3 ro = vec3(0.0, R_GROUND + max(g.sky.x, 1.0), 0.0);
    // look a touch above the horizon for the ground-facing half (the planet's own ground is
    // handled below); keeps the horizon band continuous
    vec3 dv = normalize(vec3(d.x, max(d.y, 0.0), d.z));
    vec3 T;
    vec3 sky = vec3(0.0);
    if (g.sunDir.w > 0.0) sky += atmosphere(ro, dv, 1e30, g.sunDir.xyz, g.sunDir.w, T);
    if (g.moonDir.w > 0.0) sky += atmosphere(ro, dv, 1e30, g.moonDir.xyz, g.moonDir.w, T) * vec3(0.85, 0.9, 1.0);
    // airglow + distant town light: a dim floor so moonless nights are not pure black
    sky += vec3(0.6, 0.75, 1.2) * 4e-7 * (1.0 + 2.0 * (1.0 - abs(dv.y)));

    if (d.y < 0.0) {
        // Below the horizon: lit ground (albedo g.sky.z), fading in from the horizon haze.
        vec3 Tsun = extinction(lightDepth(ro, g.sunDir.xyz));
        vec3 Tmoon = extinction(lightDepth(ro, g.moonDir.xyz));
        vec3 E = g.sunDir.w * Tsun * max(g.sunDir.y, 0.0) + g.moonDir.w * Tmoon * max(g.moonDir.y, 0.0);
        vec3 zen;
        vec3 skyUp = atmosphere(ro, vec3(0.0, 1.0, 0.0), 1e30, g.sunDir.xyz, g.sunDir.w, zen) * PI;
        vec3 ground = g.sky.z / PI * (E + skyUp * 0.5);
        sky = mix(sky, ground, smoothstep(0.0, 0.08, -d.y));
    }
    imageStore(lut, p, vec4(sky, 1.0));
}
